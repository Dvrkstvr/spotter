<!-- The foreground service a live workout runs under — see SessionService.kt
     for what it buys and SessionServiceModule.kt for the JS surface.

     The type is `specialUse`, and that is the same bet USE_EXACT_ALARM is
     (see alarms.ts): `connectedDevice` would be the honest label for the
     buddy half, but its Android 14 prerequisite is a *granted* Bluetooth
     runtime permission, which a solo lifter who declined the buddy prompts
     doesn't hold — and the service matters to them too. `specialUse` starts
     unconditionally; its cost is a Play-review question that costs nothing
     while Spotter is sideloaded. All three permissions are install-time. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <application>
    <service
        android:name="expo.modules.sessionservice.SessionService"
        android:exported="false"
        android:foregroundServiceType="specialUse">
      <property
          android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
          android:value="Keeps a live workout session and its phone-to-phone buddy link running while the screen is off" />
    </service>
  </application>
</manifest>
