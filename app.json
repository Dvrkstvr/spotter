{
  "expo": {
    "name": "Spotter",
    "slug": "spotter",
    "version": "1.3.0",
    "extra": {
      "buildName": "Connection diagnostics"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "spotter",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#161826",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.calvinkohl.workoutdiary",
      "versionCode": 7,
      "permissions": [
        "android.permission.USE_EXACT_ALARM",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#161826",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["DEFAULT", "BROWSABLE"],
          "data": [
            { "scheme": "content", "mimeType": "application/json" },
            { "scheme": "content", "mimeType": "text/plain" },
            { "scheme": "content", "mimeType": "application/octet-stream" },
            { "scheme": "file", "mimeType": "application/json" },
            { "scheme": "file", "mimeType": "text/plain" },
            { "scheme": "file", "mimeType": "application/octet-stream" }
          ]
        },
        {
          "action": "SEND",
          "category": ["DEFAULT"],
          "data": [{ "mimeType": "text/plain" }]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#161826",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Spotter uses your photos for your profile picture and your own exercise reference images.",
          "cameraPermission": "Spotter opens the camera only when you add a photo to an exercise how-to, so you can shoot the machine in front of you."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#9184d9"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "ndkVersion": "27.2.12479018",
            "buildToolsVersion": "36.0.0"
          }
        }
      ],
      "./plugins/with-android-build-tools",
      "./plugins/with-release-signing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
