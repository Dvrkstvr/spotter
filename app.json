{
  "expo": {
    "name": "Spotter",
    "slug": "spotter",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "spotter",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#161826",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.calvinkohl.workoutdiary",
      "adaptiveIcon": {
        "backgroundColor": "#161826",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#161826",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Spotter uses your photos for your profile picture and your own exercise reference images.",
          "cameraPermission": "Spotter opens the camera only when you add a photo to an exercise how-to, so you can shoot the machine in front of you."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#9184d9"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "ndkVersion": "27.2.12479018",
            "buildToolsVersion": "36.0.0"
          }
        }
      ],
      "./plugins/with-android-build-tools"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
