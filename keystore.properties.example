# Copy to `keystore.properties` (gitignored) and fill in.
#
# `storeFile` is best given as an ABSOLUTE path to somewhere outside this repo
# — a key that never sits in the tree cannot be committed by accident. A
# relative path is resolved against the repo root if you'd rather keep it here.
#
# Use FORWARD SLASHES on Windows. This is a java.util.Properties file, where a
# backslash is an escape character: `C:
ope\key.jks` silently becomes a path
# with a newline in it. `C:/keys/key.jks` has no such trap.
#
# Losing this key means losing the ability to update the app on Play. Back it
# up somewhere that survives this machine, together with the two passwords.
#
# CI sets SPOTTER_KEYSTORE / SPOTTER_KEYSTORE_PASSWORD / SPOTTER_KEY_ALIAS /
# SPOTTER_KEY_PASSWORD instead, and the environment wins over this file.

storeFile=C:/keys/spotter-upload.jks
storePassword=
keyAlias=spotter-upload
keyPassword=
